{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/marketing/**",
              "components/navigation/**",
              "components/product/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Geist|Inter Tight|Fragment Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, Geist, Inter Tight, Fragment Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlogCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|category|date|title|excerpt|author|href|style|key|ref|className|style|children)$/]",
        "message": "<BlogCard> doesn't accept that prop. Declared props: image, category, date, title, excerpt, author, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|href|onClick|fullWidth|disabled|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, href, onClick, fullWidth, disabled, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|outline)$/]",
        "message": "<Button> variant must be one of 'filled' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|children|style|key|ref|className|style|children)$/]",
        "message": "<ChatMessage> doesn't accept that prop. Declared props: role, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:user|agent)$/]",
        "message": "<ChatMessage> role must be one of 'user' | 'agent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CursorChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|color|rotate|style|key|ref|className|style|children)$/]",
        "message": "<CursorChip> doesn't accept that prop. Declared props: name, color, rotate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CursorChip'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:amber|blue)$/]",
        "message": "<CursorChip> color must be one of 'amber' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|dots|color|style|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: variant, dots, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:dashed|solid)$/]",
        "message": "<Divider> variant must be one of 'dashed' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|answer|open|onToggle|surface|style|key|ref|className|style|children)$/]",
        "message": "<FaqItem> doesn't accept that prop. Declared props: question, answer, open, onToggle, surface, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:white|card)$/]",
        "message": "<FaqItem> surface must be one of 'white' | 'card'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|open|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FeatureTab> doesn't accept that prop. Declared props: icon, title, description, open, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|size|style|key|ref|className|style|children)$/]",
        "message": "<FilterTabs> doesn't accept that prop. Declared props: items, value, onChange, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterTabs'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<FilterTabs> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|pill|description|width|style|key|ref|className|style|children)$/]",
        "message": "<FlowCard> doesn't accept that prop. Declared props: title, pill, description, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='FrameLines'] > JSXAttribute > JSXIdentifier[name!=/^(?:top|bottom|inset|color|style|key|ref|className|style|children)$/]",
        "message": "<FrameLines> doesn't accept that prop. Declared props: top, bottom, inset, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IntegrationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|name|description|href|style|key|ref|className|style|children)$/]",
        "message": "<IntegrationCard> doesn't accept that prop. Declared props: logo, name, description, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|markOnly|size|href|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: tone, markOnly, size, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Logo> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:logos|caption|marquee|height|style|key|ref|className|style|children)$/]",
        "message": "<LogoStrip> doesn't accept that prop. Declared props: logos, caption, marquee, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|style|key|ref|className|style|children)$/]",
        "message": "<MetricStat> doesn't accept that prop. Declared props: value, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavbarLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|hasMenu|key|ref|className|style|children)$/]",
        "message": "<NavbarLink> doesn't accept that prop. Declared props: label, href, hasMenu."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|active|hasMenu|tone|onClick|style|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: children, href, active, hasMenu, tone, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<NavLink> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotificationBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tint|title|subtitle|style|key|ref|className|style|children)$/]",
        "message": "<NotificationBanner> doesn't accept that prop. Declared props: icon, tint, title, subtitle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotificationBanner'] > JSXAttribute[name.name='tint'] > Literal[value!=/^(?:purple|sky|yellow|blue)$/]",
        "message": "<NotificationBanner> tint must be one of 'purple' | 'sky' | 'yellow' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|currency|priceLabel|cta|ctaHref|highlighted|badge|description|features|style|key|ref|className|style|children)$/]",
        "message": "<PricingCard> doesn't accept that prop. Declared props: name, price, currency, priceLabel, cta, ctaHref, highlighted, badge, description, features, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromptBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|onSubmit|width|height|style|key|ref|className|style|children)$/]",
        "message": "<PromptBox> doesn't accept that prop. Declared props: placeholder, value, onChange, onSubmit, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|eyebrow|align|as|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: title, description, eyebrow, align, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<SectionHeader> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2)$/]",
        "message": "<SectionHeader> as must be one of 'h1' | 'h2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedToggle> doesn't accept that prop. Declared props: options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|placeholder|name|style|key|ref|className|style|children)$/]",
        "message": "<SelectField> doesn't accept that prop. Declared props: label, options, value, onChange, placeholder, name, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|children|style|key|ref|className|style|children)$/]",
        "message": "<StepItem> doesn't accept that prop. Declared props: number, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|neutral|dark)$/]",
        "message": "<Tag> tone must be one of 'blue' | 'neutral' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|author|photo|open|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TestimonialCard> doesn't accept that prop. Declared props: quote, author, photo, open, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|multiline|type|name|required|rows|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, placeholder, value, onChange, multiline, type, name, required, rows, style."
      }
    ]
  },
